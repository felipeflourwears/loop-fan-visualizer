# Copia este archivo como .env y llena los valores de esta maquina.
# El archivo .env esta en .gitignore: NUNCA lo subas al repositorio.

# --- Sincronizacion con Google Drive (opcional) ---
# ID de la carpeta de Drive de este ventilador (si se deja vacio, no se sincroniza)
DRIVE_FOLDER_ID=
# Ruta al JSON de la cuenta de servicio de Google (guardalo dentro de credentials/)
GOOGLE_CREDENTIALS_PATH=credentials/service_account.json
MEDIA_DIR=media
SYNC_INTERVAL_SECONDS=600

# --- Servidor de control remoto (Flask) ---
SERVER_HOST=0.0.0.0
SERVER_PORT=5000
